# Cloudflare Pages headers — copied to .output/public/_headers on `nuxt generate`.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed build assets — never change under the same URL.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Pre-optimised images from @nuxt/image.
/_ipx/*
  Cache-Control: public, max-age=31536000, immutable

# The 121-frame scroll sequence — filenames are stable, cache hard.
/sequence/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
